# Supabase -> Connect -> Session pooler (project ucsysxhiydfgukkkbtdx).
# Must be the service_role/postgres user: the RPCs are granted to service_role only.
DATABASE_URL=

# From Person 3. Leave NOTIFY_URL empty to print texts to the console instead.
NOTIFY_URL=
NOTIFY_SECRET=

PORT=8000
MCP_BASE_URL=

# Dev convenience for scripts/. These match what scripts/init_db.py seeds by default;
# change them if you seed a different user. reply.py can also find the pending user
# on its own, so leaving DEMO_PHONE blank is fine in single-user development.
DEMO_KEY=demo
DEMO_PHONE=+15555550100
